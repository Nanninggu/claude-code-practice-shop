#!/bin/sh
# 커밋 직전, 스테이지된 변경의 "추가된 줄"에서 비밀로 보이는 값을 찾아 커밋을 막는다.
#  1) PG 운영 키 접두어(live 키)로 시작하는 값
#  2) 이름에 secret / token / password / api_key 가 든 변수에 문자열 값을 직접 넣은 줄
# 출력은 파일 경로와 줄 번호뿐이며, 값은 절대 출력하지 않는다.

hits=$(git diff --cached -U0 --no-color --no-ext-diff --diff-filter=ACMR | awk '
BEGIN {
  # 이 스크립트 자신이 걸리지 않도록 접두어를 쪼개서 만든다.
  live = "pg_li" "ve_"
  name = "[a-z0-9_.-]*(secret|token|password|passwd|api_?key|api-key)[a-z0-9_.-]*"
}
/^\+\+\+ / {
  file = substr($0, 7)
  if ($0 == "+++ /dev/null") file = ""
  next
}
/^@@ / {
  s = $0
  sub(/^@@ -[0-9,]+ \+/, "", s)
  sub(/[ ,].*$/, "", s)
  line = s + 0
  next
}
/^\+/ {
  if (file == "") next
  text = substr($0, 2)
  low = tolower(text)
  bad = 0
  if (index(low, live) > 0) bad = 1
  else if (match(low, name "[\"\x27]?[ \t]*[:=][ \t]*[\"\x27][^\"\x27]+[\"\x27]")) {
    seg = substr(text, RSTART, RLENGTH)
    # 값 부분(첫 따옴표 안)만 꺼내 검사한다.
    v = seg
    sub(/^[^:=]*[:=][ \t]*[\"\x27]/, "", v)
    sub(/[\"\x27]$/, "", v)
    # 환경 변수 이름(예: "PG_SECRET_KEY")이나 ${...} 자리표시자는 비밀 값이 아니므로 제외
    if (v !~ /^[A-Z][A-Z0-9_]*$/ && v !~ /^\$\{.*\}$/) bad = 1
  }
  if (bad) print file ":" line
  line++
  next
}
/^ / { line++ }
')

if [ -n "$hits" ]; then
  echo "커밋 차단: 비밀 값으로 보이는 줄이 스테이지된 변경에 있습니다. (값은 출력하지 않습니다)" >&2
  echo "$hits" | sed 's/^/  /' >&2
  echo "환경 변수로 옮기고 다시 스테이지하세요. 오탐이면 그 줄을 고쳐 쓰거나, 정말 필요할 때만 git commit --no-verify 를 쓰세요." >&2
  exit 1
fi
exit 0
